  "components": {
    "schemas": {
      "AgentControlRequest": {
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Reason",
            "default": "Operator action"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "AgentControlRequest"
      },
      "ApprovalActionRequest": {
        "properties": {
          "proposal_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Proposal Version",
            "default": 1
          },
          "comment": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          },
          "modified_parameters": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Modified Parameters"
          },
          "touches_real_money": {
            "type": "boolean",
            "title": "Touches Real Money",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ApprovalActionRequest"
      },
      "CharterUpdateRequest": {
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version",
            "description": "Active Charter version for optimistic concurrency check"
          },
          "rationale": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 3,
            "title": "Rationale"
          },
          "updated_charter": {
            "type": "object",
            "title": "Updated Charter",
            "description": "Updated Charter sections"
          },
          "tier_1_5_enabled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tier 1 5 Enabled"
          },
          "explicit_confirmation": {
            "type": "boolean",
            "title": "Explicit Confirmation",
            "description": "Must be true to confirm Tier 2 Charter modification",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_version",
          "rationale",
          "updated_charter"
        ],
        "title": "CharterUpdateRequest"
      },
      "CreateTaskRequest": {
        "properties": {
          "agent_name": {
            "type": "string",
            "minLength": 1,
            "title": "Agent Name",
            "description": "Target agent identifier in registry"
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "title": "Action",
            "description": "Agent capability to invoke"
          },
          "parameters": {
            "type": "object",
            "title": "Parameters"
          },
          "priority": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Priority",
            "description": "1 (highest) to 10 (lowest)",
            "default": 5
          },
          "tier": {
            "type": "string",
            "pattern": "^(0|1|1\\.5|2|3)$",
            "title": "Tier",
            "default": "0"
          },
          "idempotency_key": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ],
            "title": "Idempotency Key"
          },
          "estimated_cost_usd": {
            "type": "number",
            "minimum": 0.0,
            "title": "Estimated Cost Usd",
            "default": 0.0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "agent_name",
          "action"
        ],
        "title": "CreateTaskRequest"
      },
      "GoogleLoginRequest": {
        "properties": {
          "id_token": {
            "type": "string",
            "minLength": 1,
            "title": "Id Token",
            "description": "Google OAuth 2.0 ID token from Google Sign-In"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id_token"
        ],
        "title": "GoogleLoginRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "KillSwitchRequest": {
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Reason",
            "default": "Emergency kill switch activated"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "KillSwitchRequest"
      },
      "LimitsUpdateRequest": {
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          },
          "rationale": {
            "type": "string",
            "minLength": 3,
            "title": "Rationale",
            "default": "Chairman updated budget and threshold limits"
          },
          "global_daily_budget_usd": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Global Daily Budget Usd"
          },
          "global_monthly_budget_usd": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Global Monthly Budget Usd"
          },
          "per_agent_daily_share_cap": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Per Agent Daily Share Cap"
          },
          "board_daily_budget_usd": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Board Daily Budget Usd"
          },
          "tier2_action_cost_threshold_usd": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Tier2 Action Cost Threshold Usd"
          },
          "explicit_confirmation": {
            "type": "boolean",
            "title": "Explicit Confirmation",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_version"
        ],
        "title": "LimitsUpdateRequest"
      },
      "RefreshTokenRequest": {
        "properties": {
          "refresh_token": {
            "type": "string",
            "minLength": 1,
            "title": "Refresh Token",
            "description": "Issued refresh token to rotate or revoke"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "refresh_token"
        ],
        "title": "RefreshTokenRequest"
      },
      "ResumeRequest": {
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Reason",
            "default": "Chairman authorized resume from SAFE MODE"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ResumeRequest"
      },
      "TokenBundleResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "refresh_token": {
            "type": "string",
            "title": "Refresh Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "Bearer"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In"
          },
          "step_up_verified_until": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Step Up Verified Until"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "access_token",
          "refresh_token",
          "expires_in"
        ],
        "title": "TokenBundleResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}